{
    
    "manifest_version": 2,
    "name": "Netsips",
    "description": "Curate your web",
    "version": "1.3.2",
    "background": {
        "scripts": ["firebase/firebase-app.js","firebase/firebase-firestore.js","firebase/firebase-database.js","event.js"]
    },
    "browser_action": {
      
        "default_popup": "popup.html"
    },
    "externally_connectable":{
        "matches":[
            "http://*.netsips.in/*",
            "http://localhost/*" 
        ]
    },
    "permissions": [
        "tabs",
        "http://*/*",
        "https://*/*",
        "storage",
        "<all_urls>",
        "http://*.google.com/"
    ],
    "key": "",
    "icons": {
        "128": "images/extension_images/icon_128.png"
      },
    "web_accessible_resources": [
        "settings.html",
        "Raleway-Regular.ttf",
        "Manrope-VariableFont_wght.ttf"
    ],
 
    "content_security_policy": "script-src 'self' https://www.gstatic.com/ https://*.firebaseio.com https://apis.google.com; object-src 'self';"}

