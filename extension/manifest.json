{
    
    "manifest_version": 2,
    "name": "Netsips",
    "description": "Snooze content for later",
    "version": "1.3",
    "background": {
        "scripts": ["event.js"]
    },
    "browser_action": {
      
        "default_popup": "popup.html"
    },
    "permissions": [
        "tabs",
        "http://*/*",
        "https://*/*",
        "storage",
        "<all_urls>",
        "identity",
        "activeTab",
        "identity.email",
        "http://*.google.com/"
    ],
    "key": "",
    "oauth2": {
        "client_id": "792463401362-fn5qhidq4h7giup496dn54l7r4urtgr1.apps.googleusercontent.com",
        "scopes": ["https://www.googleapis.com/auth/plus.login",
          "https://www.googleapis.com/auth/userinfo.email"]
        
      },
    "icons": {
        "128": "icon_128.png"
      },
    "web_accessible_resources": [
        "settings.html",
        "signup.html"
    ],
    "content_security_policy": "script-src 'self' https://www.gstatic.com/ https://*.firebaseio.com https://apis.google.com; object-src 'self';"}

