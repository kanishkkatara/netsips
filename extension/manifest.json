{
  "manifest_version": 3,
  "name": "Netsips",
  "description": "Curate your web",
  "version": "1.4.1",
  "action": {
    "default_popup": "popup_main.html",
    "default_icon": {
      "16": "new_icon_16.png",
      "48": "new_icon_48.png",
      "128": "new_icon.png"
    }
  },
  "background": {
    "service_worker": "event.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://*.netsips.in/*",
      "https://*.netsips.in/*",
      "http://localhost/*",
      "https://localhost/*"
    ]
  },
  "key": "",
  "icons": {
    "16": "new_icon_16.png",
    "48": "new_icon_48.png",
    "128": "new_icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "settings.html",
        "new.html",
        "popup_main.html",
        "popup.html",
        "fonts/*",
        "images/*",
        "firebase/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
