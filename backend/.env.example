# Netsips Backend Configuration Example

# SMTP / Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=care.netsips@example.com
SMTP_PASS=your_gmail_app_password_here
SENDER_EMAIL=care.netsips@example.com
RECIPIENT_EMAIL=user@example.com

# Digest & Processing Settings
DIGEST_OUTPUT_DIR=./dist
DEFAULT_DELIVERY_DAY=6
MAX_DIGEST_ARTICLES=15

# Local Daemon & Webhook Settings
DAEMON_HOST=127.0.0.1
DAEMON_PORT=8765
DAEMON_SCHEDULE_DAYS="0 1 2 3 4 5 6"
DAEMON_SCHEDULE_HOUR=8
