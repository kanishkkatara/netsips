# Netsips Environment Configuration Example
# Copy this file to .env and customize values for your environment.

# ==========================================
# SMTP / Email Configuration
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=care.netsips@example.com
SMTP_PASS=your_secure_smtp_app_password
SENDER_EMAIL=care.netsips@example.com
RECIPIENT_EMAIL=user@example.com

# ==========================================
# Digest & Processing Settings
# ==========================================
DIGEST_OUTPUT_DIR=./dist
DEFAULT_DELIVERY_DAY=6
MAX_DIGEST_ARTICLES=15

# ==========================================
# Legacy Cloud Database (Optional)
# ==========================================
FIREBASE_DATABASE_URL=https://netsips-1586535958950.firebaseio.com/
FIREBASE_CREDENTIALS_PATH=./firebase-sdk.json
